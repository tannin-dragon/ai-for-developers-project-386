# Порт HTTP-сервера API.
PORT=3000

# Ключ владельца календаря (заголовок X-Owner-Key). В docker-compose задаётся
# переменной окружения OWNER_KEY; здесь — только локальный дефолт для разработки.
OWNER_KEY=dev-owner-key

# Сидировать демо-данные при старте (профиль + два типа звонков): true/false.
SEED_DEMO=true
